---
context: servonet
contexts:
  servonet:
    endpoints:
      {% for name in nodes %}
      - {{ nodes[name].endpoint }}
      {% endfor %}
    nodes:
      {% for name in nodes %}
      - {{ nodes[name].endpoint }}
      {% endfor %}
    # ca: Talos machine CA (Bitwarden MACHINE_CA_CRT). admin crt/key are
    # minted per-render by the `talosconfig` recipe and injected via yq.
    ca: {{ ENV.MACHINE_CA_CRT }}
